#!/bin/sh

# Only use TLS distribution when DeployEx (or another supervisor) has
# actually provisioned the cert config at this path. Forcing it
# unconditionally means the release can never boot standalone - e.g.
# under relup-guard-elixir, or any plain `bin/myumbrella start` outside
# of DeployEx - since nothing else creates this file.
if [ -f /tmp/inet_tls.conf ]; then
  export ELIXIR_ERL_OPTIONS="-proto_dist inet_tls -ssl_dist_optfile /tmp/inet_tls.conf"
fi

# Set a default Erlang cookie value if not provided by ENV VAR.
# This default is temporary; update it using AWS secrets and config provider.
#
# Note: these use if/fi rather than `[ cond ] && action`. When the guard
# is skipped (the var is already set), that one-liner's exit status is
# the condition's own failure, not 0 - and as the last command of a
# script sourced under `set -e` (as bin/<release> does), that aborts the
# boot with no error output. if/fi always returns 0 when no branch runs.
if [ -z "${RELEASE_COOKIE}" ]; then
  export RELEASE_COOKIE="cookie"
fi

# Default to shortnames, but don't clobber a caller that already set this
# (e.g. relup-guard-elixir sets RELEASE_DISTRIBUTION=name for its own
# ephemeral node, which an unconditional override here breaks).
if [ -z "${RELEASE_DISTRIBUTION}" ]; then
  export RELEASE_DISTRIBUTION=sname
fi
